VITE_API_URL=http://localhost:3001
VITE_APP_NAME=SAK100
VITE_APP_VERSION=1.0.0

# Public Google OAuth 2.0 client ID (safe to expose in the browser bundle)
# VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Google Maps Embed API key (browser-restricted; safe to expose in the browser)
# Set it or the asset map embed falls back to a generic link only.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_embed_key
