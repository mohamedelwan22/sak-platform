  pending
  completed
  failed
}

model ProfitDistribution {
  id             String         @id @default(uuid()) @db.Uuid
  landId         String         @map("land_id") @db.Uuid
  totalProfitUsd Decimal        @map("total_profit_usd") @db.Decimal(20, 8)
  periodStart    DateTime       @map("period_start")
  periodEnd      DateTime       @map("period_end")
  distributedBy  String         @map("distributed_by") @db.Uuid
  distributedAt  DateTime       @default(now()) @map("distributed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  land           Land           @relation(fields: [landId], references: [id])
  distributor    User           @relation(fields: [distributedBy], references: [id])
  payouts        ProfitPayout[]

  @@index([landId])
  @@index([distributedAt])
  @@map("profit_distributions")
}

model ProfitPayout {
  id               String             @id @default(uuid()) @db.Uuid
  distributionId   String             @map("distribution_id") @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  holdingId        String             @map("holding_id") @db.Uuid
  ownershipPercent Decimal            @map("ownership_percent") @db.Decimal(8, 4)
  payoutUsd        Decimal            @map("payout_usd") @db.Decimal(20, 8)
  payoutSak        Decimal            @map("payout_sak") @db.Decimal(20, 4)
  status           ProfitPayoutStatus @default(pending)
  createdAt        DateTime           @default(now()) @map("created_at")
  distribution     ProfitDistribution @relation(fields: [distributionId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
  holding          Holding            @relation(fields: [holdingId], references: [id])

  @@index([distributionId])
  @@index([userId])
  @@index([holdingId])
  @@map("profit_payouts")
}

model Certificate {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  holdingId   String   @map("holding_id") @db.Uuid
  filePath    String   @map("file_path")
  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])
  holding     Holding  @relation(fields: [holdingId], references: [id])

  @@index([userId])
  @@index([holdingId])
  @@map("certificates")
}

// ─────────────────────────────────────────────
// PHASE 04 — BROKER, REFERRAL, LEAD, COMMISSION
// ─────────────────────────────────────────────

model BrokerProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  displayName        String    @map("display_name") @db.VarChar(100)
  company            String?   @db.VarChar(150)
  licenseNumber      String?   @map("license_number") @db.VarChar(100)
  phone              String?   @db.VarChar(30)
  bio                String?
  profileImageUrl    String?   @map("profile_image_url") @db.VarChar(512)
  verificationStatus String    @default("pending") @map("verification_status") @db.VarChar(30)
  verifiedAt         DateTime? @map("verified_at")
  verifiedBy         String?   @map("verified_by") @db.Uuid
  rejectionReason    String?   @map("rejection_reason")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifier    User?                 @relation("BrokerVerifier", fields: [verifiedBy], references: [id])
  documents   BrokerDocument[]
  leads       Lead[]                @relation("BrokerLeads")
  clients     BrokerClient[]        @relation("BrokerClients")
  commissions AffiliateCommission[]
  investmentRequests InvestmentRequest[]

  @@index([verificationStatus])
  @@index([isActive])
  @@index([createdAt])
  @@map("broker_profiles")
}

model BrokerDocument {
  id         String    @id @default(uuid()) @db.Uuid
  brokerId   String    @map("broker_id") @db.Uuid
  type       String    @db.VarChar(50) // license, id, company_reg, other
  label      String?   @db.VarChar(150)
  filePath   String    @map("file_path")
  isVerified Boolean   @default(false) @map("is_verified")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  broker BrokerProfile @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("broker_documents")
}

// Referral / Affiliate relation — one referrer, one referred, unique pair
model AffiliateRelation {
  id           String   @id @default(uuid()) @db.Uuid
  referrerId   String   @map("referrer_id") @db.Uuid
  referredId   String   @unique @map("referred_id") @db.Uuid // each user referred once only
  referralCode String   @map("referral_code") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referred User @relation("Referred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([referralCode])
  @@map("affiliate_relations")
}

// Commission record — one per holding + type + beneficiary (idempotency)
model AffiliateCommission {
  id             String    @id @default(uuid()) @db.Uuid
  beneficiaryId  String    @map("beneficiary_id") @db.Uuid // wallet owner who receives
  brokerId       String?   @map("broker_id") @db.Uuid // broker profile if applicable
  referrerId     String?   @map("referrer_id") @db.Uuid // User.id of referrer
  holdingId      String    @map("holding_id") @db.Uuid
  commissionType String    @default("referral") @map("commission_type") @db.VarChar(30)
  baseAmountUsd  Decimal   @map("base_amount_usd") @db.Decimal(20, 8)
  ratePercent    Decimal   @map("rate_percent") @db.Decimal(7, 4)
  commissionUsd  Decimal   @map("commission_usd") @db.Decimal(20, 8)
  commissionSak  Decimal   @map("commission_sak") @db.Decimal(20, 4)
  sakPriceAtCalc Decimal   @map("sak_price_at_calc") @db.Decimal(12, 4)
  status         String    @default("pending") @db.VarChar(20) // pending|approved|rejected|paid|cancelled
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  paidAt         DateTime? @map("paid_at")
  payoutId       String?   @map("payout_id") @db.Uuid
  rejectionReason String?  @map("rejection_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  beneficiary User            @relation("CommissionBeneficiary", fields: [beneficiaryId], references: [id])
  approver    User?           @relation("CommissionApprover", fields: [approvedBy], references: [id])
  broker      BrokerProfile?  @relation(fields: [brokerId], references: [id])
  holding     Holding         @relation(fields: [holdingId], references: [id])
  payout      CommissionPayout? @relation(fields: [payoutId], references: [id])

  @@unique([holdingId, commissionType, beneficiaryId])
  @@index([beneficiaryId])
  @@index([brokerId])
  @@index([status])
  @@index([payoutId])
  @@index([createdAt])
  @@map("affiliate_commissions")
}

// Commission payout batch — one payout may cover one or many commissions.
model CommissionPayout {
  id            String   @id @default(uuid()) @db.Uuid
  beneficiaryId String   @map("beneficiary_id") @db.Uuid // wallet owner receiving the payout
  transactionId String   @unique @map("transaction_id") @db.Uuid // wallet transaction for the payout
  totalUsd      Decimal  @map("total_usd") @db.Decimal(20, 8)
  totalSak      Decimal  @map("total_sak") @db.Decimal(20, 4)
  status        String   @default("completed") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  beneficiary User                @relation("PayoutBeneficiary", fields: [beneficiaryId], references: [id])
  transaction Transaction         @relation("PayoutTransaction", fields: [transactionId], references: [id])
  commissions AffiliateCommission[]

  @@index([beneficiaryId])
  @@index([transactionId])
  @@map("commission_payouts")
}

// Configurable commission rates — admin managed, additive history
model CommissionRate {
  id            String    @id @default(uuid()) @db.Uuid
  type          String    @db.VarChar(30) // referral | broker
  ratePercent   Decimal   @map("rate_percent") @db.Decimal(7, 4)
  isDefault     Boolean   @default(false) @map("is_default")
  brokerId      String?   @map("broker_id") @db.Uuid // null = default, set = broker-specific
  landId        String?   @map("land_id") @db.Uuid // null = all assets, set = asset-specific
  effectiveFrom DateTime  @map("effective_from")
  expiresAt     DateTime? @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id])

  @@index([type, isDefault, isActive])
  @@index([brokerId])
  @@index([effectiveFrom])
  @@map("commission_rates")
}

// Broker → Client association
model BrokerClient {
  id        String   @id @default(uuid()) @db.Uuid
  brokerId  String   @map("broker_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  broker BrokerProfile @relation("BrokerClients", fields: [brokerId], references: [id])
  client User          @relation("ClientBrokers", fields: [clientId], references: [id])

  @@unique([brokerId, clientId])
  @@index([brokerId])
  @@index([clientId])
  @@map("broker_clients")
}

model Lead {
  id           String    @id @default(uuid()) @db.Uuid
  brokerId     String?   @map("broker_id") @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  landId       String?   @map("land_id") @db.Uuid
  source       String    @default("organic") @db.VarChar(50) // organic|referral|broker|direct
  referralCode String?   @map("referral_code") @db.VarChar(20)
  status       String    @default("new") @db.VarChar(30)
  // new|contacted|qualified|viewing_requested|viewing_completed
  // |booking_requested|booked|converted|lost|closed
  notes        String?
  contactName  String?   @map("contact_name") @db.VarChar(100)
  contactPhone String?   @map("contact_phone") @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  broker          BrokerProfile?   @relation("BrokerLeads", fields: [brokerId], references: [id])
  client          User             @relation("ClientLeads", fields: [clientId], references: [id])
  land            Land?            @relation("LandLeads", fields: [landId], references: [id])
  assignments     LeadAssignment[]
  viewingRequests ViewingRequest[]
  bookingRequests BookingRequest[]

  @@index([brokerId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

model LeadAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  fromBrokerId String?  @map("from_broker_id") @db.Uuid
  toBrokerId   String   @map("to_broker_id") @db.Uuid
  assignedBy   String   @map("assigned_by") @db.Uuid
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  lead     Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigner User @relation("LeadAssigner", fields: [assignedBy], references: [id])

  @@index([leadId])
  @@index([toBrokerId])
  @@map("lead_assignments")
}

model ViewingRequest {
  id            String    @id @default(uuid()) @db.Uuid
  leadId        String    @map("lead_id") @db.Uuid
  landId        String    @map("land_id") @db.Uuid
  requestedById String    @map("requested_by_id") @db.Uuid // client user id
  brokerId      String?   @map("broker_id") @db.Uuid
  status        String    @default("pending") @db.VarChar(30)
  // pending|accepted|rejected|scheduled|completed|cancelled
  requestedAt   DateTime  @default(now()) @map("requested_at")
  scheduledAt   DateTime? @map("scheduled_at")
  completedAt   DateTime? @map("completed_at")
  cancelledAt   DateTime? @map("cancelled_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lead        Lead @relation(fields: [leadId], references: [id])
  land        Land @relation("LandViewings", fields: [landId], references: [id])
  requestedBy User @relation("ViewingRequester", fields: [requestedById], references: [id])

  @@index([leadId])
  @@index([landId])
  @@index([brokerId])
  @@index([status])
  @@map("viewing_requests")
}

model BookingRequest {
  id            String   @id @default(uuid()) @db.Uuid
  leadId        String   @map("lead_id") @db.Uuid
  landId        String   @map("land_id") @db.Uuid
  requestedById String   @map("requested_by_id") @db.Uuid
  brokerId      String?  @map("broker_id") @db.Uuid
  status        String   @default("pending") @db.VarChar(30)
  // pending|under_review|approved|rejected|cancelled|converted
  notes         String?
  holdingId     String?  @unique @map("holding_id") @db.Uuid // set when converted to investment
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lead        Lead     @relation(fields: [leadId], references: [id])
  land        Land     @relation("LandBookings", fields: [landId], references: [id])
  requestedBy User     @relation("BookingRequester", fields: [requestedById], references: [id])
  holding     Holding? @relation("BookingHolding", fields: [holdingId], references: [id])

  @@index([leadId])
  @@index([landId])
  @@index([brokerId])
  @@index([status])
  @@map("booking_requests")
}

// Investment Request — explicit request before an order/holding is executed.
// source: platform (direct) | broker
// status: submitted|under_review|approved|rejected|cancelled|invested|failed
model InvestmentRequest {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  landId     String    @map("land_id") @db.Uuid
  brokerId   String?   @map("broker_id") @db.Uuid
  amountUsd  Decimal   @map("amount_usd") @db.Decimal(20, 8)
  source     String    @default("platform") @map("source") @db.VarChar(20)
  status     String    @default("submitted") @db.VarChar(30)
  reviewNote String?   @map("review_note")
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at")
  holdingId  String?   @unique @map("holding_id") @db.Uuid // set when invested via existing flow
  // Task 6: manual payment lifecycle attached to the request (no separate payment model)
  paymentStatus          String    @default("payment_pending") @map("payment_status") @db.VarChar(30)
  paymentMethod          String?   @map("payment_method") @db.VarChar(50)
  paymentProofPath       String?   @map("payment_proof_path")
  paymentProofUploadedAt DateTime? @map("payment_proof_uploaded_at")
  paymentReviewedBy      String?   @map("payment_reviewed_by") @db.Uuid
  paymentReviewedAt      DateTime? @map("payment_reviewed_at")
  paymentNote            String?   @map("payment_note")
  rejectionReason        String?   @map("rejection_reason")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  investor        User            @relation("InvestmentInvestor", fields: [userId], references: [id])
  land            Land            @relation("LandInvestments", fields: [landId], references: [id])
  broker          BrokerProfile?  @relation(fields: [brokerId], references: [id])
  reviewer        User?           @relation("InvestmentReviewer", fields: [reviewedBy], references: [id])
  paymentReviewer User?           @relation("InvestmentPaymentReviewer", fields: [paymentReviewedBy], references: [id])
  holding         Holding?        @relation(fields: [holdingId], references: [id])

  @@index([userId])
  @@index([landId])
  @@index([brokerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("investment_requests")
}

// Immutable correction record when attribution must change post-conversion
model AttributionCorrection {
  id          String   @id @default(uuid()) @db.Uuid
  holdingId   String   @unique @map("holding_id") @db.Uuid
  oldBrokerId String?  @map("old_broker_id") @db.Uuid
  newBrokerId String?  @map("new_broker_id") @db.Uuid
  reason      String
  approvedBy  String   @map("approved_by") @db.Uuid
  approvedAt  DateTime @default(now()) @map("approved_at")

  holding  Holding @relation(fields: [holdingId], references: [id])
  approver User    @relation("CorrectionApprover", fields: [approvedBy], references: [id])

  @@index([holdingId])
  @@map("attribution_corrections")
}

model AssetType {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique @db.VarChar(50) // land, hotel, resort, commercial …
  nameEn        String   @map("name_en") @db.VarChar(100)
  nameAr        String   @map("name_ar") @db.VarChar(100)
  descriptionEn String?  @map("description_en")
  descriptionAr String?  @map("description_ar")
  isSystem      Boolean  @default(false) @map("is_system") // built-in types cannot be deleted
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  creator   User                   @relation("AssetTypeCreator", fields: [createdBy], references: [id])
  fieldDefs AssetFieldDefinition[]

  @@index([isActive])
  @@map("asset_types")
}

model AssetFieldDefinition {
  id              String   @id @default(uuid()) @db.Uuid
  assetTypeId     String   @map("asset_type_id") @db.Uuid
  fieldKey        String   @map("field_key") @db.VarChar(80) // machine name e.g. "area_m2"
  labelEn         String   @map("label_en") @db.VarChar(150)
  labelAr         String   @map("label_ar") @db.VarChar(150)
  fieldType       String   @map("field_type") @db.VarChar(30)
  // text|textarea|number|decimal|boolean|date|select|multi_select|url|image|document
  isRequired      Boolean  @default(false) @map("is_required")
  isSearchable    Boolean  @default(false) @map("is_searchable")
  isFilterable    Boolean  @default(false) @map("is_filterable")
  isPublic        Boolean  @default(true) @map("is_public") // false = admin-only
  options         Json? // for select/multi_select: [{value,labelEn,labelAr}]
  validationRules Json?    @map("validation_rules") // {min,max,pattern,…}
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  assetType AssetType         @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  values    AssetFieldValue[]

  @@unique([assetTypeId, fieldKey])
  @@index([assetTypeId])
  @@map("asset_field_definitions")
}

model AssetFieldValue {
  id          String   @id @default(uuid()) @db.Uuid
  landId      String   @map("land_id") @db.Uuid
  fieldDefId  String   @map("field_def_id") @db.Uuid
  valueText   String?  @map("value_text")
  valueNumber Decimal? @map("value_number") @db.Decimal(20, 6)
  valueJson   Json?    @map("value_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  land     Land                 @relation("LandFieldValues", fields: [landId], references: [id], onDelete: Cascade)
  fieldDef AssetFieldDefinition @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)

  @@unique([landId, fieldDefId])
  @@index([landId])
  @@index([fieldDefId])
  @@map("asset_field_values")
}

// Homepage CMS — single-row config with JSON sections
model HomepageConfig {
  id             String   @id @default(uuid()) @db.Uuid
  heroTitleEn    String   @default("") @map("hero_title_en")
  heroTitleAr    String   @default("") @map("hero_title_ar")
  heroSubtitleEn String   @default("") @map("hero_subtitle_en")
  heroSubtitleAr String   @default("") @map("hero_subtitle_ar")
  heroDescEn     String   @default("") @map("hero_desc_en")
  heroDescAr     String   @default("") @map("hero_desc_ar")
  heroImageUrl   String?  @map("hero_image_url") @db.VarChar(512)
  heroCtaTextEn  String   @default("") @map("hero_cta_text_en")
  heroCtaTextAr  String   @default("") @map("hero_cta_text_ar")
  heroCtaUrl     String   @default("/projects") @map("hero_cta_url") @db.VarChar(512)
  heroEnabled    Boolean  @default(true) @map("hero_enabled")
  sections       Json     @default("[]") // ordered array of section configs
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("homepage_configs")
}
